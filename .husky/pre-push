#!/bin/sh
set -e
# The remote carries `main` and release tags, nothing else.
#
# This used to be a deny-list for `internal` and `axiomics`. With the deployment
# notes out of git entirely (internal/ is ignored, never committed) and only one
# branch published, an allow-list states the rule instead of trying to keep up
# with the branches we do not want: whatever else is local — an experiment, a
# branch kept for a merge, the next working branch — has no way out by accident.
while read -r local_ref _local_sha remote_ref _remote_sha; do
  # Deleting a remote ref is the cleanup path for leftovers (a merged branch, a
  # snapshot branch that outlived the model). Only creating or moving a ref is
  # restricted, so deletions pass.
  [ "$local_ref" = "(delete)" ] && continue
  case "$remote_ref" in
    refs/heads/main | refs/tags/*) ;;
    *)
      echo "拒绝推送 $remote_ref：远程只接受 main 和发布标签。" >&2
      exit 1
      ;;
  esac
done

# Full local validation is opt-in: AXIOMICS_PUSH_CHECKS=1 git push
[ "${AXIOMICS_PUSH_CHECKS:-0}" = "1" ] || exit 0

# Check if bun version matches package.json
# keep in sync with tooling/script/src/index.ts semver qualifier
bun -e '
import { semver } from "bun";
const pkg = await Bun.file("package.json").json();
const expectedBunVersion = pkg.packageManager?.split("@")[1];
if (!expectedBunVersion) {
  throw new Error("packageManager field not found in root package.json");
}
const expectedBunVersionRange = `^${expectedBunVersion}`;
if (!semver.satisfies(process.versions.bun, expectedBunVersionRange)) {
  throw new Error(`This script requires bun@${expectedBunVersionRange}, but you are using bun@${process.versions.bun}`);
}
if (process.versions.bun !== expectedBunVersion) {
  console.warn(`Warning: Bun version ${process.versions.bun} differs from expected ${expectedBunVersion}`);
}
'
bun typecheck
