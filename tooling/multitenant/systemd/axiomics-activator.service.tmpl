[Unit]
Description=Axiomics 按需激活器（被回收的租户在下一个认证请求时拉起）
# AX_ROOT 必须在持久盘上；挂载失败时宁可不起服务，也不要在空目录上跑。
RequiresMountsFor=__AX_ROOT__
After=network.target __UNIT_PREFIX__-gateway.service

[Service]
# RequiresMountsFor 在**用户级**单元里不会生成 Requires= —— 用户管理器不能 Require
# 系统级挂载单元，它只留下 After=。所以真正的兜底是下面两条显式检查：
#   ① AX_ROOT 目录不存在 —— 数据盘没挂上（或从未部署），拒绝启动；
#   ② __AX_REQUIRE_MOUNT__ 非空时，该挂载点必须真的挂着 —— 否则 /disk1 这类挂载点
#      会以一个空目录的形式"存在"，目录检查照样通过，用户看到项目全空、新写入落到
#      系统盘。deploy.sh 在 AX_ROOT 位于独立挂载点时自动填入，留空则只做 ①。
ExecStartPre=/bin/sh -c '[ -d __AX_ROOT__ ] || { echo "AX_ROOT __AX_ROOT__ 不存在 —— 拒绝启动" >&2; exit 1; }'
ExecStartPre=/bin/sh -c 'test -z "__AX_REQUIRE_MOUNT__" || findmnt -M "__AX_REQUIRE_MOUNT__" >/dev/null || { echo "数据盘 __AX_REQUIRE_MOUNT__ 未挂载 —— 拒绝启动" >&2; exit 1; }'
Type=simple
# 与 deploy.sh 里启动时同一组环境变量。写成单元文件而不是 nohup 的原因：
# 重启机器后没人来敲这条命令，租户就永远不会被唤醒（网关会一直 502/503）。
Environment=AX_ROOT=__AX_ROOT__
Environment=AX_ACTIVATOR_PORT=__ACTIVATOR_PORT__
Environment=AX_MAP=__AX_ROOT__/tenants.map
Environment=AX_TENANT_CMD=__AX_ROOT__/bin/axiomics-tenant
Environment=AX_AUDIT=__AX_ROOT__/logs/audit.jsonl
# Bun 在进程启动时固定代理配置。宿主 shell 若设了 http_proxy，没有 no_proxy 时
# 连 127.0.0.1:42xxx 的健康检查都会被送进代理 → 每个租户判 TIMEOUT → 全体 503。
Environment=no_proxy=__NO_PROXY__
Environment=NO_PROXY=__NO_PROXY__
# 绝对路径：bun 通常只在 ~/.bun/bin，不在 systemd 用户单元的默认 PATH 里。
ExecStart=__BUN__ run __AX_ROOT__/bin/axiomics-activator.ts
Restart=always
RestartSec=3
StandardOutput=append:__AX_ROOT__/logs/activator.log
StandardError=append:__AX_ROOT__/logs/activator.log

[Install]
WantedBy=default.target
